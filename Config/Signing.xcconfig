// Signing for the DecentDigest app target.
//
// Each developer's own team ID lives in Config/Local.xcconfig, which git ignores,
// so choosing a team never changes the project file. Create that file with one line:
//
//     DEVELOPMENT_TEAM = YOURTEAMID
//
// WeatherKit needs a paid Apple Developer Program team. Once WeatherKit is turned on for the
// app's identifier, add this second line to Local.xcconfig to sign with its entitlement:
//
//     CODE_SIGN_ENTITLEMENTS = Config/WeatherKit.entitlements
//
// Without it the app builds with a personal team, and debug builds show sample weather.

#include? "Local.xcconfig"
